# .env.example — Radar Informativo Globale
# Copia questo file in .env e compila i valori reali.
# NON committare il file .env su Git (è già in .gitignore).
#
# Quickstart:
#   cp .env.example .env && docker compose up -d --build
#   UI → http://localhost/   (FE host 80 → container Nginx 8080 on all interfaces)
#
# Ports / overrides (see ops/README.md):
#   Default:           FE 80:8080 (0.0.0.0); Miniflux NOT published
#   Hardened loopback: docker compose -f docker-compose.yml -f docker-compose.hardened.yml up -d
#                      → FE 127.0.0.1:80 + Miniflux admin 127.0.0.1:8080
#   Miniflux LAN UI:   docker compose -f docker-compose.yml -f docker-compose.lan.yml up -d
#                      → Miniflux http://localhost:8080
#
# Health:
#   /health/live  — process up (Compose healthcheck + FE depends_on)
#   /health/ready — pool + migrations + worker heartbeat (ops only; may 503 on first boot)

# ─── Runtime / ambiente (Phase 1) ─────────────────────────────────────────────
# development | production (alias: prod). In production fallisce lo startup se
# mancano Miniflux/DB o se resta la password PostgreSQL di default.
RADAR_ENV=development
# IANA timezone per quote/ledger (UTC non richiede tzdata su Windows).
RADAR_TIME_ZONE=UTC

# ─── CORS (Phase 3) ───────────────────────────────────────────────────────────
# CSV allowlist for browser origins that call the API *directly* (not via Nginx).
# Production behind Nginx same-origin: leave EMPTY (never use *).
# Local Angular ng serve without proxy.conf.json:
#   CORS_ALLOW_ORIGINS=http://localhost:4200
CORS_ALLOW_ORIGINS=

# ─── Worker heartbeat / readiness (Phase 3 — parent implements writer + /health/ready) ─
# Interval at which the leader worker UPSERTs worker_heartbeat (seconds).
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# /health/ready fails if heartbeat older than this (default 90 ≈ 3× interval).
WORKER_HEARTBEAT_STALE_SECONDS=90

# ─── LLM lanes (SIMPLE / COMPLEX) ─────────────────────────────────────────────
# Ogni lane e indipendente: provider + modello + API key + RPM/TPM/RPD + budget.
# PROVIDER (tipo adapter):
#   gemini | deepseek | openai | glm | grok | claude
#   - gemini  = google-genai SDK
#   - deepseek / openai / glm / grok = httpx OpenAI-compat (/chat/completions)
#   - claude  = stub (Anthropic Messages API non implementata; usare un proxy
#               OpenAI-compat con PROVIDER=openai + BASE_URL se serve)
# Dialect payload:
#   deepseek → campi thinking/reasoning_effort DeepSeek
#   openai | glm | grok → chat/completions stock (niente campi DeepSeek-only)
#
# Limiti rate (per lane, NON globali):
#   RPM = requests/minuto   | 0 = non gestito dal ledger
#   TPM = token/minuto      | 0 = non gestito
#   RPD = requests/giorno   | 0 = non gestito (niente soft-trim worker su quella lane)
# Soft-trim worker = solo LLM_SIMPLE.rpd se > 0 (indipendente dal provider).
#   Se residual COMPLEX distinto → NON ibernare il ciclo (failover per-articolo).
# Soft-cap soldi (opz.): BUDGET_USD_DAY > 0 + USD_PER_1M_TOKENS (stima, non listino live).
#
# Free vs paid:
#   Free (Gemini Studio) → RPM/RPD(+TPM) > 0 (VERIFY_IN_STUDIO)
#   Paid (DeepSeek/OpenAI/…) → RPM/RPD = 0 + BUDGET_USD_DAY (opz.) / 402 hard-fail
#
# Failover S3 (vincolante — plan-audit/complete/audit_llm_lane_env_generalization.md):
#   L1 = primary + LLM_*_FALLBACKS (CSV modelli STESSO provider; non cross-provider)
#   L2 = residual cross-lane (altra lane se identity diversa; NO se SIMPLE = Ollama-think)
#   L3 = fallback article
# RPM/TPM pieni: QuotaLedger attende sulla stessa lane (non cross).
# RPD/cooldown: residual L2 (cloud). Ollama-think SIMPLE: niente L2 → L3 article.
#
# Chiavi intenzionalmente vuote (OK):
#   LLM_SIMPLE_API_KEY / LLM_COMPLEX_API_KEY → legacy fill-gap provider key
#   *_FALLBACKS= (chiave presente, vuota) → nessun L1; residual = L2 (non CSV cross-provider)
#   LLM_SIMPLE_BASE_URL → solo OpenAI-compat (vuoto se gemini)
#   CORS_ALLOW_ORIGINS → vuoto dietro Nginx same-origin
# Convenzione: UN solo blocco profilo attivo (commentare gli altri).
#
# Profili:
#   B (attivo sotto) = DeepSeek-only
#   A (commentato)   = TARGET tipico: Gemini Flash Lite SIMPLE + DeepSeek COMPLEX
#   C/D/E            = OpenAI / GLM / Grok
#   F                = Local-Hybrid Ollama (opt-in + overlay; non sporca cloud-only)
# Routing complessita
LLM_ROUTING_MODE=complexity
LLM_ROUTING_SHADOW=false
LLM_ROUTING_STRICT=0
LLM_COMPLEXITY_ESCALATE_ON_VALIDATION=1
LLM_MODEL_COOLDOWN_HOURS=24
# Effort reasoning per la sola fascia BORDERLINE sulla catena COMPLEX.
# Default safe / clone = high (AS-IS se unset). Target ops Profilo A post-GATE: none in ops .env (non in questo example).
# none | high | max (off/disabled → none; low/medium → high)
LLM_BORDERLINE_REASONING_EFFORT=high
# Token stimati in reserve prima della call (aggiornati con usage reale al complete).
ESTIMATED_TOKENS_PER_REQUEST=1500

# --- Profilo B attivo: DeepSeek-only (ricetta #2) ---
# Lane SIMPLE (articoli lane SIMPLE)
# DeepSeek V4 Flash NON-thinking (effort=none). Bulk a basso costo.
# Complessità v2.2: solo lane SIMPLE (0 famiglie forti, o solo L).
# BORDERLINE e COMPLEX usano LLM_COMPLEX (thinking high).
# API ufficiale: solo deepseek-v4-flash | deepseek-v4-pro.
LLM_SIMPLE_PROVIDER=deepseek
LLM_SIMPLE_MODEL=deepseek-v4-flash
# Vuoto = legacy DEEPSEEK_API_KEY
LLM_SIMPLE_API_KEY=
LLM_SIMPLE_BASE_URL=https://api.deepseek.com
# VUOTO = nessun L1 same-provider; residual L2 = COMPLEX se identity diversa
LLM_SIMPLE_FALLBACKS=
# Paid tipico: 0 = unmanaged (niente limiti Studio Gemini)
LLM_SIMPLE_RPM=0
LLM_SIMPLE_TPM=0
LLM_SIMPLE_RPD=0
# Soft-cap USD/giorno (0 = off)
LLM_SIMPLE_BUDGET_USD_DAY=0
LLM_SIMPLE_USD_PER_1M_TOKENS=0.28
LLM_SIMPLE_TIMEOUT=60
# none|off|disabled = thinking disabled; high = thinking (COMPLEX)
LLM_SIMPLE_REASONING_EFFORT=none

# Lane COMPLEX (BORDERLINE + COMPLEX + escalate / residual)
LLM_COMPLEX_PROVIDER=deepseek
LLM_COMPLEX_MODEL=deepseek-v4-flash
# Vuoto = legacy DEEPSEEK_API_KEY (o OPENAI_API_KEY se provider=openai)
LLM_COMPLEX_API_KEY=
LLM_COMPLEX_BASE_URL=https://api.deepseek.com
# VUOTO = nessun secondo sostituto dedicato (L1); residual L2 = SIMPLE
LLM_COMPLEX_FALLBACKS=
# Paid tipico: RPM/TPM/RPD = 0 (unmanaged). Soft-cap solo via BUDGET se serve.
LLM_COMPLEX_RPM=0
LLM_COMPLEX_TPM=0
LLM_COMPLEX_RPD=0
LLM_COMPLEX_BUDGET_USD_DAY=0
# Stima $/1M token solo per soft-cap (ininfluente se BUDGET=0)
LLM_COMPLEX_USD_PER_1M_TOKENS=0.28
LLM_COMPLEX_TIMEOUT=60
LLM_COMPLEX_REASONING_EFFORT=high

# --- Profilo A (hybrid TARGET) — ricetta #1; decommentare e spegnere il blocco B sopra ---
# Free Gemini SIMPLE + paid DeepSeek COMPLEX. Sostituto SIMPLE→DeepSeek = residual L2
# (NON mettere deepseek-* in LLM_SIMPLE_FALLBACKS: FALLBACKS è same-provider only).
# LLM_SIMPLE_PROVIDER=gemini
# LLM_SIMPLE_MODEL=gemini-3.5-flash-lite
# LLM_SIMPLE_API_KEY=          # o legacy GEMINI_API_KEY (lasciare vuoto se usi legacy)
# LLM_SIMPLE_BASE_URL=         # lasciare VUOTO per gemini (solo OpenAI-compat)
# LLM_SIMPLE_RPM=12            # Studio tipico 15 — cap ops ≤12 (default di lane per ogni modello)
# LLM_SIMPLE_TPM=250000        # Studio 250K (default di lane per ogni modello)
# LLM_SIMPLE_RPD=500           # Default per-modello (primary e FALLBACKS hanno pool RPD da 500 separati; 0 = unmanaged)
# LLM_SIMPLE_MODEL_LIMITS=     # Opzionale override CSV: model:rpm:tpm:rpd,model2:... (es. gemini-3.5-flash-lite:12:250000:500,gemini-3.1-flash-lite:15:250000:500)
# LLM_SIMPLE_BUDGET_USD_DAY=0
# LLM_SIMPLE_REASONING_EFFORT=
# LLM_SIMPLE_FALLBACKS=gemini-3.1-flash-lite  # L1 same-provider Gemini; L2 residual = COMPLEX DeepSeek
# Gemini 3.1 Flash Lite limits: RPM=15 TPM=250000 RPD=500
# Semantica limiti (obbligatoria):
#   RPM/TPM pieni → attesa sulla STESSA lane (non si usa l'altro modello)
#   RPD esaurita su un modello → failover L1 al modello successivo in catena con contatore indipendente
#   Soft-trim: se tutti i modelli SIMPLE sono esausti ma residual COMPLEX distinto → ciclo NON iberna
# LLM_COMPLEX_PROVIDER=deepseek
# LLM_COMPLEX_MODEL=deepseek-v4-flash
# LLM_COMPLEX_API_KEY=         # o legacy DEEPSEEK_API_KEY
# LLM_COMPLEX_BASE_URL=https://api.deepseek.com
# LLM_COMPLEX_FALLBACKS=       # VUOTO = nessun L1; residual L2 = Gemini se DeepSeek down
# LLM_COMPLEX_MODEL_LIMITS=    # Opzionale override CSV per la lane complex
# LLM_COMPLEX_RPM=0
# LLM_COMPLEX_TPM=0
# LLM_COMPLEX_RPD=0
# LLM_COMPLEX_BUDGET_USD_DAY=5
# LLM_COMPLEX_REASONING_EFFORT=high

# --- Profilo C (OpenAI) — dialect openai, niente thinking DeepSeek ---
# LLM_SIMPLE_PROVIDER=openai
# LLM_SIMPLE_MODEL=gpt-4.1-mini
# LLM_SIMPLE_API_KEY=          # o legacy OPENAI_API_KEY
# LLM_SIMPLE_BASE_URL=https://api.openai.com/v1
# LLM_SIMPLE_RPM=0
# LLM_SIMPLE_RPD=0
# LLM_SIMPLE_BUDGET_USD_DAY=5
# LLM_SIMPLE_USD_PER_1M_TOKENS=0.40
# LLM_SIMPLE_REASONING_EFFORT=none
# LLM_COMPLEX_PROVIDER=openai
# LLM_COMPLEX_MODEL=gpt-4.1
# LLM_COMPLEX_API_KEY=
# LLM_COMPLEX_BASE_URL=https://api.openai.com/v1
# LLM_COMPLEX_RPM=0
# LLM_COMPLEX_RPD=0
# LLM_COMPLEX_BUDGET_USD_DAY=10
# LLM_COMPLEX_USD_PER_1M_TOKENS=2.00
# LLM_COMPLEX_REASONING_EFFORT=high

# --- Profilo D (GLM / Zhipu) — OpenAI-compat dialect openai ---
# LLM_SIMPLE_PROVIDER=glm
# LLM_SIMPLE_MODEL=glm-4-flash
# LLM_SIMPLE_API_KEY=          # o legacy GLM_API_KEY / ZHIPU_API_KEY
# LLM_SIMPLE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_SIMPLE_RPM=0
# LLM_SIMPLE_RPD=0
# LLM_SIMPLE_BUDGET_USD_DAY=3
# LLM_SIMPLE_USD_PER_1M_TOKENS=0.10
# LLM_SIMPLE_REASONING_EFFORT=none
# LLM_COMPLEX_PROVIDER=glm
# LLM_COMPLEX_MODEL=glm-4-plus
# LLM_COMPLEX_API_KEY=
# LLM_COMPLEX_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_COMPLEX_RPM=0
# LLM_COMPLEX_RPD=0
# LLM_COMPLEX_BUDGET_USD_DAY=5
# LLM_COMPLEX_USD_PER_1M_TOKENS=1.00
# LLM_COMPLEX_REASONING_EFFORT=high

# --- Profilo E (Grok / xAI) — OpenAI-compat dialect openai ---
# LLM_SIMPLE_PROVIDER=grok
# LLM_SIMPLE_MODEL=grok-3-mini
# LLM_SIMPLE_API_KEY=          # o legacy GROK_API_KEY / XAI_API_KEY
# LLM_SIMPLE_BASE_URL=https://api.x.ai/v1
# LLM_SIMPLE_RPM=0
# LLM_SIMPLE_RPD=0
# LLM_SIMPLE_BUDGET_USD_DAY=5
# LLM_SIMPLE_USD_PER_1M_TOKENS=0.30
# LLM_SIMPLE_REASONING_EFFORT=none
# LLM_COMPLEX_PROVIDER=grok
# LLM_COMPLEX_MODEL=grok-3
# LLM_COMPLEX_API_KEY=
# LLM_COMPLEX_BASE_URL=https://api.x.ai/v1
# LLM_COMPLEX_RPM=0
# LLM_COMPLEX_RPD=0
# LLM_COMPLEX_BUDGET_USD_DAY=10
# LLM_COMPLEX_USD_PER_1M_TOKENS=3.00
# LLM_COMPLEX_REASONING_EFFORT=high


# --- Profilo F (Local-Hybrid) — ricetta #3; Scenario 2; Ollama host + DeepSeek COMPLEX ---
# Prereq: Ollama sull'host con modello pullato (tag ops gemma4-radar (FROM gemma4:12b + num_ctx 8192)); overlay
#   docker compose -f docker-compose.yml -f docker-compose.ollama-host.yml up -d radar-worker
# Path: HTTP OpenAI-compat httpx (PROVIDER=openai). Vietato package/SDK ollama.
# Soft-trim: RPD=0 → unmanaged (no hibernation da locale).
# Client: think=true; num_ctx/num_predict=8192; normalize;
#   NO escalate ValidationError e NO residual L2 SIMPLE→cloud (isolamento 54c8038).
#   Se Ollama down su articoli SIMPLE → fallback article (non DeepSeek).
# Ops tip: WORKER_*_CONCURRENCY=1; OLLAMA_NUM_PARALLEL=1; TIMEOUT 180 o 600.
# VRAM lifecycle (worker): keep_alive busy sulle classify; unload nativo keep_alive=0 a fine ciclo idle.
# OLLAMA_AUTO_UNLOAD=true
# OLLAMA_KEEP_ALIVE_BUSY=5m
# OLLAMA_KEEP_ALIVE_IDLE=0
# OLLAMA_UNLOAD_DEBOUNCE_SECONDS=60
# Spegnere il blocco B (o A) sopra prima di attivare F. Cloud-only (#8): lasciare F commentato + no overlay.
# LLM_SIMPLE_PROVIDER=openai
# LLM_SIMPLE_MODEL=gemma4-radar
# LLM_SIMPLE_API_KEY=ollama
# LLM_SIMPLE_BASE_URL=http://host.docker.internal:11434/v1
# LLM_SIMPLE_FALLBACKS=
# LLM_SIMPLE_RPM=0
# LLM_SIMPLE_TPM=0
# LLM_SIMPLE_RPD=0
# LLM_SIMPLE_BUDGET_USD_DAY=0
# LLM_SIMPLE_TIMEOUT=180
# LLM_SIMPLE_REASONING_EFFORT=high  # Gemma4 thinking sempre
# LLM_COMPLEX_PROVIDER=deepseek
# LLM_COMPLEX_MODEL=deepseek-v4-flash
# LLM_COMPLEX_API_KEY=         # o legacy DEEPSEEK_API_KEY
# LLM_COMPLEX_BASE_URL=https://api.deepseek.com
# LLM_COMPLEX_FALLBACKS=
# LLM_COMPLEX_RPM=0
# LLM_COMPLEX_TPM=0
# LLM_COMPLEX_RPD=0
# LLM_COMPLEX_BUDGET_USD_DAY=0
# LLM_COMPLEX_TIMEOUT=60
# LLM_COMPLEX_REASONING_EFFORT=high


# --- Ricette topologia 1–8 (chiavi essenziali; un solo blocco attivo) ---
# #1 TARGET A = Profilo A sopra (Gemini Lite + DeepSeek; *_FALLBACKS=)
# #2 Paid same/mix = Profilo B (attivo) o C/D/E o mix lane indipendenti
# #3 SIMPLE locale + COMPLEX cloud = Profilo F + overlay ollama-host
# #4 Dual-local = entrambe PROVIDER=openai + stesso BASE_URL host; due MODEL (VRAM risk)
# #5 SIMPLE cloud + COMPLEX locale = gemini SIMPLE + openai/gemma4* COMPLEX + overlay
# #6 Una lane effettiva = COMPLEX identico a SIMPLE (effort può differire) oppure COMPLEX down→SIMPLE
# #7 L1 same-provider es. LLM_SIMPLE_FALLBACKS=gemini-2.5-flash (PROVIDER=gemini);
#    L2 residual = altra lane (mai deepseek-* in FALLBACKS se PROVIDER=gemini)
# #8 Cloud-only = A o B; F commentato; compose SENZA -f docker-compose.ollama-host.yml
# Gateway Kimi/etc.: PROVIDER=openai + BASE_URL custom + MODEL + API_KEY (enum chiuso; no token kimi)
# Audit: plan-audit/complete/audit_llm_lane_env_generalization.md

# --- Legacy (opzionale fill-gap) ---
# Usati SOLO se il campo lane corrispondente e *assente* dall'env (non se = vuoto/0 esplicito).
# Con Profilo B sopra (LLM_SIMPLE_*/LLM_COMPLEX_* tutti settati), questi limiti sono INERTI.
# Non sono limiti "globali": non mischiano SIMPLE e COMPLEX.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Vuoto: niente fallback CSV; residual = altra lane
GEMINI_MODEL_FALLBACKS=
# Alias legacy → default di LLM_SIMPLE_RPM/TPM/RPD solo se quei campi lane NON esistono
LLM_RPM=30
LLM_TPM=16000
LLM_RPD=14400
GEMINI_REQUEST_TIMEOUT=60
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Alias legacy → default di LLM_COMPLEX_RPM/TPM/RPD solo se quei campi lane NON esistono
DEEPSEEK_RPM=0
DEEPSEEK_TPM=0
DEEPSEEK_RPD=0
DEEPSEEK_BUDGET_USD_DAY=0
DEEPSEEK_USD_PER_1M_TOKENS=0.28
# Fill-gap se PROVIDER=openai|glm|grok e LLM_*_API_KEY assente
OPENAI_API_KEY=
GLM_API_KEY=
ZHIPU_API_KEY=
GROK_API_KEY=
XAI_API_KEY=

# ─── Miniflux Feed Aggregator ─────────────────────────────────────────────────
# URL base della tua istanza Miniflux (es. http://radar-miniflux:8080 se in Docker)
# Host :8080 is unpublished by default — use docker-compose.lan.yml or hardened override for admin UI.
MINIFLUX_API_URL=http://radar-miniflux:8080
# API Key Miniflux (Settings → API Keys → Create API Key)
# Dopo la key: importa i feed versionati (Git Bash/WSL):
#   docker compose -f docker-compose.yml -f docker-compose.lan.yml up -d
#   ./ops/import-miniflux-feeds.sh
# SoT: config/miniflux-feeds.seed.json (+ .opml). Guida: docs/01_getting_started.md §6
MINIFLUX_API_KEY=
# Secret per la verifica della firma HMAC dei webhook (Settings → Integrations → Webhook)
# URL webhook: http://radar-backend:8000/api/webhooks/miniflux
MINIFLUX_WEBHOOK_SECRET=
MINIFLUX_ADMIN_USERNAME=admin
# Dev ready-to-run default (change in production). No `$` in passwords.
MINIFLUX_ADMIN_PASSWORD=radar_dev_admin

# Limite massimo di articoli da scaricare per singolo ciclo
# (polling = WORKER_POLL_INTERVAL_SECONDS, default 900).
# Impostare a 2-5 per i test di sviluppo iniziale, 50-100 per la produzione.
MINIFLUX_LIMIT=50

# Boundary HTTP: rifiuta body Miniflux oltre questo tetto (byte).
MAX_MINIFLUX_RESPONSE_BYTES=5000000
# Boundary entry: rifiuta content/summary oltre questo tetto (byte UTF-8).
MAX_ENTRY_CONTENT_BYTES=500000
# Timeout e retry httpx verso Miniflux (solo errori retryable + Retry-After).
MINIFLUX_CONNECT_TIMEOUT=10
MINIFLUX_READ_TIMEOUT=30
MINIFLUX_MAX_RETRIES=3
MINIFLUX_RETRY_BASE_SECONDS=1
MINIFLUX_RETRY_MAX_SECONDS=30

# Outbox Vault: dopo quanti secondi una riga 'writing' stale torna 'pending'.
OUTBOX_STALE_WRITING_SECONDS=300

# ─── Worker ingest (radar-worker / python -m app.worker) ───────────────────────
# Coda bounded + N consumer; semafori separati PARSE / DB / GEMINI.
WORKER_QUEUE_DEPTH=100
WORKER_ENTRY_CONCURRENCY=4
WORKER_PARSE_CONCURRENCY=8
WORKER_DB_CONCURRENCY=4
# Max concurrent Gemini HTTP calls (DeepSeek not gated by this).
WORKER_GEMINI_CONCURRENCY=2
# Timeout (secondi) per await dei consumer cancellati allo shutdown.
WORKER_SHUTDOWN_TIMEOUT=30
# Intervallo polling Miniflux di sicurezza a coda vuota (default 15 min safety net).
# NOTA: Webhook/NOTIFY e avvio eseguono eager drain-until-empty prima dell'attesa.
WORKER_POLL_INTERVAL_SECONDS=900
# Sosta di assestamento (secondi) post-refresh_all_feeds() su boot/timeout safety (0..120, default 15).
WORKER_REFRESH_SETTLE_SECONDS=15
# Chiave fissa pg_try_advisory_lock (session-level, connessione dedicata).
WORKER_ADVISORY_LOCK_KEY=742014722
# Backoff (secondi) se la leadership non è acquisita (processo resta in vita).
WORKER_ADVISORY_LOCK_BACKOFF_SECONDS=5

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_USER=radar_user
# Dev ready-to-run default (change in production). No `$` in passwords (Compose interpolation).
POSTGRES_PASSWORD=radar_dev_password
POSTGRES_DB=radar_db
# DATABASE_URL viene costruito automaticamente dall'applicazione a partire dalle variabili POSTGRES_* sopra.
# Nel fare ciò, le credenziali vengono codificate con quote_plus per supportare caratteri speciali (es. @, :, /, #).
# Se si definisce manualmente DATABASE_URL (per connettersi ad esempio a un DB esterno), assicurarsi che sia già percent-encoded.
# Nota per Miniflux: Miniflux non usa config.py, quindi se POSTGRES_PASSWORD contiene caratteri speciali,
# potrebbe essere necessario percent-encodarli manualmente nel file .env o usare una password alfanumerica.
# DATABASE_URL=postgresql://radar_user:TUA_PASSWORD_PERCENT_ENCODED@localhost:5432/radar_db
# ─── Deduplicazione Semantica & Quality Balanced (Fase C - pgvector) ───────────
SEMANTIC_DEDUP_ENABLED=true
SEMANTIC_DEDUP_SIMILARITY_THRESHOLD=0.80
SEMANTIC_DEDUP_LOOKBACK_HOURS=24
SEMANTIC_EMBEDDING_MODEL=all-MiniLM-L6-v2
SEMANTIC_PREFILTER_LEN_RATIO=0.7
SEMANTIC_QUALITY_REPLACE_HINT_RATIO=1.25
# FinOps Wave A: Direct Bypass High-Sim (M5) & Content Hash (M6)
SEMANTIC_DEDUP_DIRECT_DISTANCE=0.05
SEMANTIC_DEDUP_DIRECT_MIN_WORDS=70
SEMANTIC_DEDUP_DIRECT_TITLE_SIM=0.90
SEMANTIC_DEDUP_DIRECT_SHADOW=false
CONTENT_HASH_DEDUP_ENABLED=true
CONTENT_HASH_LOOKBACK_HOURS=24
# Future doc-only knob (non implementare branch codice in Fase C):
# SEMANTIC_QUALITY_SEND_FULL=false

