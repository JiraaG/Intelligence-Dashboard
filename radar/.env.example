# .env.example — Radar Informativo Globale
# Copia questo file in .env e compila i valori reali.
# NON committare il file .env su Git (è già in .gitignore).

# ─── Runtime / ambiente (Phase 1) ─────────────────────────────────────────────
# development | production (alias: prod). In production fallisce lo startup se
# mancano Miniflux/DB o se resta la password PostgreSQL di default.
RADAR_ENV=development
# IANA timezone per quote/ledger (UTC non richiede tzdata su Windows).
RADAR_TIME_ZONE=UTC

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Ottieni la chiave da: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modello LLM da utilizzare (es. gemma-4-31b, gemini-3.1-flash-lite, gemini-2.0-flash)
GEMINI_MODEL=gemma-4-31b-it

# Rate Limits e Governance (ledger durable llm_request_ledger)
LLM_RPM=10
LLM_TPM=0
LLM_RPD=1400
# Deadline applicativa (secondi) su ogni generate_content (asyncio.wait_for).
GEMINI_REQUEST_TIMEOUT=60
# Stima token prenotata prima di ogni tentativo provider (TPM; aggiornata con usage reale).
ESTIMATED_TOKENS_PER_REQUEST=1500

# ─── Miniflux Feed Aggregator ─────────────────────────────────────────────────
# URL base della tua istanza Miniflux (es. http://radar-miniflux:8080 se in Docker, o http://localhost:8080)
MINIFLUX_API_URL=http://radar-miniflux:8080
# API Key Miniflux (Settings → API Keys → Create API Key)
MINIFLUX_API_KEY=
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=

# Limite massimo di articoli da scaricare per singolo ciclo (polling ogni 15 min).
# Impostare a 2-5 per i test di sviluppo iniziale, 50-100 per la produzione.
MINIFLUX_LIMIT=50

# Boundary HTTP: rifiuta body Miniflux oltre questo tetto (byte).
MAX_MINIFLUX_RESPONSE_BYTES=5000000
# Boundary entry: rifiuta content/summary oltre questo tetto (byte UTF-8).
MAX_ENTRY_CONTENT_BYTES=500000
# Timeout e retry httpx verso Miniflux (solo errori retryable + Retry-After).
MINIFLUX_CONNECT_TIMEOUT=10
MINIFLUX_READ_TIMEOUT=30
MINIFLUX_MAX_RETRIES=3
MINIFLUX_RETRY_BASE_SECONDS=1
MINIFLUX_RETRY_MAX_SECONDS=30

# Outbox Vault: dopo quanti secondi una riga 'writing' stale torna 'pending'.
OUTBOX_STALE_WRITING_SECONDS=300

# ─── Worker ingest (radar-worker / python -m app.worker) ───────────────────────
# Coda bounded + N consumer; semafori separati PARSE / DB / GEMINI.
WORKER_QUEUE_DEPTH=100
WORKER_ENTRY_CONCURRENCY=4
WORKER_PARSE_CONCURRENCY=8
WORKER_DB_CONCURRENCY=4
WORKER_GEMINI_CONCURRENCY=2
# Timeout (secondi) per await dei consumer cancellati allo shutdown.
WORKER_SHUTDOWN_TIMEOUT=30
# Intervallo polling Miniflux tra un ciclo e il successivo (default 15 min).
WORKER_POLL_INTERVAL_SECONDS=900
# Chiave fissa pg_try_advisory_lock (session-level, connessione dedicata).
WORKER_ADVISORY_LOCK_KEY=742014722
# Backoff (secondi) se la leadership non è acquisita (processo resta in vita).
WORKER_ADVISORY_LOCK_BACKOFF_SECONDS=5

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=
POSTGRES_DB=radar_db
# DATABASE_URL è costruito automaticamente da docker-compose con le variabili sopra.
# In sviluppo locale (fuori Docker), puoi impostarlo manualmente:
# DATABASE_URL=postgresql://radar_user:TUA_PASSWORD@localhost:5432/radar_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@radar-db:5432/${POSTGRES_DB}
