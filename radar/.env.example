# .env.example — Radar Informativo Globale
# Copia questo file in .env e compila i valori reali.
# NON committare il file .env su Git (è già in .gitignore).
#
# Quickstart:
#   cp .env.example .env && docker compose up -d --build
#   UI → http://localhost/   (FE published 80:80 on all interfaces)
#
# Ports / overrides (see ops/README.md):
#   Default:           FE 80:80 (0.0.0.0); Miniflux NOT published
#   Hardened loopback: docker compose -f docker-compose.yml -f docker-compose.hardened.yml up -d
#                      → FE 127.0.0.1:80 + Miniflux admin 127.0.0.1:8080
#   Miniflux LAN UI:   docker compose -f docker-compose.yml -f docker-compose.lan.yml up -d
#                      → Miniflux http://localhost:8080
#
# Health:
#   /health/live  — process up (Compose healthcheck + FE depends_on)
#   /health/ready — pool + migrations + worker heartbeat (ops only; may 503 on first boot)

# ─── Runtime / ambiente (Phase 1) ─────────────────────────────────────────────
# development | production (alias: prod). In production fallisce lo startup se
# mancano Miniflux/DB o se resta la password PostgreSQL di default.
RADAR_ENV=development
# IANA timezone per quote/ledger (UTC non richiede tzdata su Windows).
RADAR_TIME_ZONE=UTC

# ─── CORS (Phase 3) ───────────────────────────────────────────────────────────
# CSV allowlist for browser origins that call the API *directly* (not via Nginx).
# Production behind Nginx same-origin: leave EMPTY (never use *).
# Local Angular ng serve without proxy.conf.json:
#   CORS_ALLOW_ORIGINS=http://localhost:4200
CORS_ALLOW_ORIGINS=

# ─── Worker heartbeat / readiness (Phase 3 — parent implements writer + /health/ready) ─
# Interval at which the leader worker UPSERTs worker_heartbeat (seconds).
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# /health/ready fails if heartbeat older than this (default 90 ≈ 3× interval).
WORKER_HEARTBEAT_STALE_SECONDS=90

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Ottieni la chiave da: https://aistudio.google.com/app/apikey
# Optional for first boot: API + DB + FE start without it; worker logs and stays
# degraded (heartbeat only) until the key is set.
GEMINI_API_KEY=
# Modello LLM da utilizzare (es. gemma-4-31b, gemini-3.1-flash-lite, gemini-2.0-flash)
GEMINI_MODEL=gemma-4-31b-it

# Rate Limits e Governance (ledger durable llm_request_ledger)
LLM_RPM=10
LLM_TPM=0
LLM_RPD=1400
# Deadline applicativa (secondi) su ogni generate_content (asyncio.wait_for).
GEMINI_REQUEST_TIMEOUT=60
# Stima token prenotata prima di ogni tentativo provider (TPM; aggiornata con usage reale).
ESTIMATED_TOKENS_PER_REQUEST=1500

# ─── Miniflux Feed Aggregator ─────────────────────────────────────────────────
# URL base della tua istanza Miniflux (es. http://radar-miniflux:8080 se in Docker)
# Host :8080 is unpublished by default — use docker-compose.lan.yml or hardened override for admin UI.
MINIFLUX_API_URL=http://radar-miniflux:8080
# API Key Miniflux (Settings → API Keys → Create API Key)
MINIFLUX_API_KEY=
MINIFLUX_ADMIN_USERNAME=admin
# Dev ready-to-run default (change in production). No `$` in passwords.
MINIFLUX_ADMIN_PASSWORD=radar_dev_admin

# Limite massimo di articoli da scaricare per singolo ciclo (polling ogni 15 min).
# Impostare a 2-5 per i test di sviluppo iniziale, 50-100 per la produzione.
MINIFLUX_LIMIT=50

# Boundary HTTP: rifiuta body Miniflux oltre questo tetto (byte).
MAX_MINIFLUX_RESPONSE_BYTES=5000000
# Boundary entry: rifiuta content/summary oltre questo tetto (byte UTF-8).
MAX_ENTRY_CONTENT_BYTES=500000
# Timeout e retry httpx verso Miniflux (solo errori retryable + Retry-After).
MINIFLUX_CONNECT_TIMEOUT=10
MINIFLUX_READ_TIMEOUT=30
MINIFLUX_MAX_RETRIES=3
MINIFLUX_RETRY_BASE_SECONDS=1
MINIFLUX_RETRY_MAX_SECONDS=30

# Outbox Vault: dopo quanti secondi una riga 'writing' stale torna 'pending'.
OUTBOX_STALE_WRITING_SECONDS=300

# ─── Worker ingest (radar-worker / python -m app.worker) ───────────────────────
# Coda bounded + N consumer; semafori separati PARSE / DB / GEMINI.
WORKER_QUEUE_DEPTH=100
WORKER_ENTRY_CONCURRENCY=4
WORKER_PARSE_CONCURRENCY=8
WORKER_DB_CONCURRENCY=4
WORKER_GEMINI_CONCURRENCY=2
# Timeout (secondi) per await dei consumer cancellati allo shutdown.
WORKER_SHUTDOWN_TIMEOUT=30
# Intervallo polling Miniflux tra un ciclo e il successivo (default 15 min).
WORKER_POLL_INTERVAL_SECONDS=900
# Chiave fissa pg_try_advisory_lock (session-level, connessione dedicata).
WORKER_ADVISORY_LOCK_KEY=742014722
# Backoff (secondi) se la leadership non è acquisita (processo resta in vita).
WORKER_ADVISORY_LOCK_BACKOFF_SECONDS=5

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_USER=radar_user
# Dev ready-to-run default (change in production). No `$` in passwords (Compose interpolation).
POSTGRES_PASSWORD=radar_dev_password
POSTGRES_DB=radar_db
# DATABASE_URL viene costruito automaticamente dall'applicazione a partire dalle variabili POSTGRES_* sopra.
# Nel fare ciò, le credenziali vengono codificate con quote_plus per supportare caratteri speciali (es. @, :, /, #).
# Se si definisce manualmente DATABASE_URL (per connettersi ad esempio a un DB esterno), assicurarsi che sia già percent-encoded.
# Nota per Miniflux: Miniflux non usa config.py, quindi se POSTGRES_PASSWORD contiene caratteri speciali,
# potrebbe essere necessario percent-encodarli manualmente nel file .env o usare una password alfanumerica.
# DATABASE_URL=postgresql://radar_user:TUA_PASSWORD_PERCENT_ENCODED@localhost:5432/radar_db

