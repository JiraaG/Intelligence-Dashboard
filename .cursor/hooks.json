{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python .cursor/hooks/pre-tool-use-adapter.py",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "python .cursor/hooks/post-tool-use-adapter.py",
        "timeout": 60
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/post-tool-use-adapter.py",
        "timeout": 60
      }
    ]
  }
}
